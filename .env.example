# Deno API 监听端口
PORT=8000
# Deno 服务与 db:migrate 使用的 SQLite 路径，父目录需预先存在
DATABASE_PATH=./pushrss.db
# 32 字节随机数的标准 Base64 编码，使用 `openssl rand -base64 32` 生成
PUSHRSS_MASTER_KEY=

# 用户自行设置的管理密码，填写任意非空密码；Deno 使用 .env，Workers 本地使用 .dev.vars
PUSHRSS_ADMIN_PASSWORD=

# 订阅源拉取间隔和到期检查间隔，单位为正整数分钟
PUSHRSS_FETCH_INTERVAL_MINUTES=30
PUSHRSS_CHECK_INTERVAL_MINUTES=1
