{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pushrss",
  "main": "packages/platform/cloudflare/main.ts",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/health"
    ],
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pushrss",
      "database_id": "12345678-1234-1234-1234-123456781234",
      "migrations_dir": "packages/db/migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOB_QUEUE",
        "queue": "pushrss-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "pushrss-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 4,
        "max_concurrency": 5
      }
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
